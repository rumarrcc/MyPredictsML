# ============================================================
# .env.production.example - MyPredicts en AWS
# No contiene secretos reales. Copiar como /etc/mypredicts/api.env en EC2.
# ============================================================

FLASK_ENV=production
AUTO_MIGRATE=false

# RDS PostgreSQL opcional
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@CHANGE_ME_RDS_ENDPOINT:5432/stockpredictor

# Fallback si decides usar PostgreSQL local en EC2:
# DATABASE_URL=postgresql://mypredicts:CHANGE_ME_PASSWORD@localhost:5432/stockpredictor

# Redis local en la EC2
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Secretos Flask/JWT. Generar fuera del repo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# Dominios
CORS_ORIGINS=https://mypredicts.es,https://www.mypredicts.es
FRONTEND_URL=https://www.mypredicts.es
BACKEND_URL=https://api.mypredicts.es

# Stripe
STRIPE_TEST_MODE=false
STRIPE_CURRENCY=eur
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=CHANGE_ME_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_AMOUNT_CENTS=999
STRIPE_SUCCESS_URL=https://www.mypredicts.es/billing?success=1
STRIPE_CANCEL_URL=https://www.mypredicts.es/billing?canceled=1
COIN_SUCCESS_URL=https://www.mypredicts.es/coins/success
COIN_CANCEL_URL=https://www.mypredicts.es/coins/cancel

# APIs externas opcionales
FINNHUB_API_KEY=CHANGE_ME
YFINANCE_TIMEOUT=10

# Email opcional
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_DEFAULT_SENDER=CHANGE_ME
EMAIL_REQUIRE_VERIFICATION=true
EMAIL_VALIDATE_DOMAIN=true
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_MINUTES=30

# Admin inicial para manage_db.py si lo quieres crear desde CLI
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mypredicts.es
ADMIN_PASSWORD=CHANGE_ME
