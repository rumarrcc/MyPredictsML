# ============================================================
# .env.example - MyPredicts backend
# Copia este archivo como .env solo para desarrollo local.
# No pongas aqui claves reales; el .env local nunca debe subirse.
# ============================================================

# Flask
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=dev-local-change-me-32-chars-minimum
JWT_SECRET_KEY=jwt-local-change-me-32-chars-minimum
AUTO_MIGRATE=false

# Base de datos local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockpredictor

# Redis / Celery local
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email local opcional
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@mypredicts.local
EMAIL_REQUIRE_VERIFICATION=true
EMAIL_VALIDATE_DOMAIN=true
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_MINUTES=30

# CORS local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Datos financieros
YFINANCE_TIMEOUT=10
FINNHUB_API_KEY=

# Stripe local
STRIPE_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CURRENCY=eur
STRIPE_PRO_AMOUNT_CENTS=999
STRIPE_SUCCESS_URL=http://localhost:5173/billing?success=1
STRIPE_CANCEL_URL=http://localhost:5173/billing?canceled=1

# Admin inicial opcional para manage_db.py
ADMIN_USERNAME=admin
