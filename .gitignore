# ============================================================
# .gitignore — StockPredictorPro
# ============================================================

# ──────────────────────────────────────────────────────────
# FRONTEND — Builds y dependencias
# ──────────────────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/node_modules/
frontend/vite-dev*.log
frontend/vite.config.js.timestamp-*.mjs
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ──────────────────────────────────────────────────────────
# BACKEND — Builds, entornos y compilaciones Python
# ──────────────────────────────────────────────────────────
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/.Python
backend/build/
backend/dist/
backend/*.egg-info/
backend/.eggs/
backend/.env
backend/.flaskenv

# Base de datos SQLite local
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/instance/

# Logs Flask / Gunicorn
backend/logs/
backend/*.log

# Celery
backend/celerybeat-schedule
backend/celerybeat.pid

# ──────────────────────────────────────────────────────────
# PYTHON — General
# ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# ──────────────────────────────────────────────────────────
# NODE / NPM — General
# ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
*.log

# ──────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — NUNCA subir
# ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example
!**/.env.*.example
!**/.env*.example

# Credenciales y artefactos sensibles
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials
credentials.*
credentials.csv
aws-credentials*
.aws/
.boto
.kube/
*.kubeconfig
*.tfstate
*.tfstate.*
crash.log

# Artefactos locales de despliegue AWS que pueden contener IDs o endpoints
ecs-task*.json
s3-policy.json
deploy/aws-cli/.outputs/
deploy/aws-cli/config.ps1
deploy/aws-cli/config.local.ps1
outputs/

# Paquetes y volcados locales
*.zip
*.7z
*.tar
*.tgz
*.gz
*.rar
*.dump
*.backup
*.sql
*.psql

# ──────────────────────────────────────────────────────────
# SISTEMA OPERATIVO
# ──────────────────────────────────────────────────────────

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ──────────────────────────────────────────────────────────
# EDITORES E IDEs
# ──────────────────────────────────────────────────────────

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm...)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.emacs.desktop

# ──────────────────────────────────────────────────────────
# DOCKER — No subir datos persistentes
# ──────────────────────────────────────────────────────────
docker-data/
postgres-data/
redis-data/

# ──────────────────────────────────────────────────────────
# PROPHET / CMDSTAN — Binarios compilados (>200MB)
# ──────────────────────────────────────────────────────────
~/.cmdstan/
cmdstan/
.cmdstan/

# ──────────────────────────────────────────────────────────
# MISCELÁNEA
# ──────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
*.patch
