[Unit]
Description=MyPredicts API
After=network.target redis-server.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/mypredicts/backend
EnvironmentFile=/etc/mypredicts/api.env
ExecStart=/opt/mypredicts/backend/.venv/bin/gunicorn "wsgi:app" --workers 2 --bind 127.0.0.1:8000 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
