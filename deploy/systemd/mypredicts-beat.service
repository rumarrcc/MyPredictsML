[Unit]
Description=MyPredicts Celery Beat
After=network.target redis-server.service mypredicts-api.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/mypredicts/backend
EnvironmentFile=/etc/mypredicts/api.env
ExecStart=/opt/mypredicts/backend/.venv/bin/celery -A app.tasks.celery_app beat --loglevel=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
